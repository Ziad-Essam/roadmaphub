# Copy to infra/.env (git-ignored). Read only by infra/scripts/create-secrets.sh,
# which stores the values in AWS Secrets Manager. Never commit infra/.env.
RESEND_API_KEY=
RESEND_FROM='RoadmapHub <onboarding@resend.dev>'
# Leave empty to use Cloudflare's public test keys (always pass)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# First administrator (used by scripts/create-admin.sh)
ADMIN_NAME='Product Team Admin'
ADMIN_EMAIL=
ADMIN_PASSWORD=
